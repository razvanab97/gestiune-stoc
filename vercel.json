{
  "version": 2,
  "name": "gestiune-stoc",
  "regions": ["dub1"],
  "rewrites": [
    {
      "source": "/produs/:id(\\d+)",
      "destination": "/api/product-page?id=:id"
    },
    {
      "source": "/staff",
      "destination": "/staff.html"
    },
    {
      "source": "/staff.html",
      "destination": "/staff.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
